index 0000000..47c35a2
--- /dev/null
+++ b/target/linux/ipq40xx/base-files/etc/init.d/mt7615_reboot
@@ -0,0 +1,13 @@
+#!/bin/sh /etc/rc.common
+
+STOP=60
+
+stop() {
+	. /lib/functions.sh
+
+	case $(board_name) in
+		hiwifi,c526a)
+			rmmod mt7615e
+			;;
+	esac
+}
